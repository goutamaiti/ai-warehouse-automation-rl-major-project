# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- training artefacts ---
# Intermediate checkpoints and TensorBoard traces are large and regenerable.
rl_agent/models/*_best/
rl_agent/models/*_checkpoints/
data/logs/

# The three final policies (~550 KB each) ARE committed, so the dashboard demo
# and `--skip-training` work without retraining first.
!rl_agent/models/ppo_default.zip
!rl_agent/models/ppo_dynamic.zip
!rl_agent/models/ppo_battery.zip

# Replays and result files ARE committed (they are real experiment output and
# the dashboard reads them), so data/episodes and data/results stay tracked.

# --- node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
*.local

# Generated by frontend/scripts/copy-data.mjs on every dev/build run; the
# originals live in data/ and must not be duplicated in version control.
frontend/public/data/

# --- editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- deployment ---
.vercel
.env
.env.*
!.env.example

# Claude Code local settings
.claude/
